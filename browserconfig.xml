<?xml version="1.0" encoding="utf-8"?>
<browserconfig>
  <msapplication>
    <tile>
      <square70x70logo src="/images/tile-small.png"/>
      <square150x150logo src="/images/tile-medium.png"/>
      <wide310x150logo src="/images/tile-wide.png"/>
      <square310x310logo src="/images/tile-large.png"/>
      <TileColor>#3b82f6</TileColor>
      <TileImage src="/images/tile-medium.png"/>
      <square70x70logo src="/images/mstile-70x70.png"/>
      <square150x150logo src="/images/mstile-150x150.png"/>
      <wide310x150logo src="/images/mstile-310x150.png"/>
      <square310x310logo src="/images/mstile-310x310.png"/>
    </tile>
    <badge>
      <polling-uri src="/badge.xml"/>
      <frequency>30</frequency>
    </badge>
    <lockScreen>
      <notification frequency>30</notification>
    </lockScreen>
  </msapplication>
</browserconfig>
